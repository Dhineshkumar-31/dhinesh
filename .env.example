# Database Connection URL
# For local SQLite development (zero-config, runs anywhere):
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase / Neon / Vercel Postgres / AWS RDS):
# DATABASE_URL="postgresql://user:password@host:5432/veetukanakku?schema=public"

# Authentication secret (JWT signing, min 32 chars)
AUTH_SECRET="veetukanakku-secure-production-ready-auth-secret-key-32chars"

# Default Initial Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminPassword@123"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (defaults to secure local uploads in public/uploads)
STORAGE_PROVIDER="local"
